          "name": "List files that exist in the root of your vault.\n",
          "request": {
            "name": "List files that exist in the root of your vault.\n",
            "description": {
              "content": "Lists files in the root directory of your vault.\n\nNote: that this is exactly the same API endpoint as the below \"List files that exist in the specified directory.\" and exists here only due to a quirk of this particular interactive tool.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vault",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Binding host",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "HTTPS port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
