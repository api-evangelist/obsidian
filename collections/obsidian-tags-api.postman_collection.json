      "item": [
        {
          "id": "5e559432-c951-4f33-9334-afa2cf36adcf",
          "name": "Get a list of all tags with metadata.\n",
          "request": {
            "name": "Get a list of all tags with metadata.\n",
            "description": {
              "content": "Returns all tags found across all files in the vault, drawn from both inline (`#tag`) and frontmatter tag syntax. Each tag is returned without the `#` prefix. Hierarchical tags (e.g. `work/tasks`) also contribute a count to every parent prefix (e.g. `work`), mirroring how Obsidian displays tag counts in its sidebar.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tags",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Binding host",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "HTTPS port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "3f21de28-25b7-491f-bdf3-9dd09f7fda1c",
              "name": "A list of tags with their usage counts.",
              "originalRequest": {
                "url": {
                  "path": [
                    "tags",
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
