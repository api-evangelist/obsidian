      "item": [
        {
          "id": "ec78f003-8c9b-4873-a808-9c6f8014b4a7",
          "name": "Open the specified document in the Obsidian user interface.\n",
          "request": {
            "name": "Open the specified document in the Obsidian user interface.\n",
            "description": {
              "content": "Note: Obsidian will create a new document at the path you have\nspecified if such a document did not already exist.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "open",
                ":filename"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "newLeaf",
                  "value": "<boolean>",
                  "description": "Open this as a new leaf?"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<path>",
                  "key": "filename",
                  "description": "(Required) Path to the file to return (relative to your vault root).\n"
                },
                {
                  "description": "Binding host",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "HTTPS port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "ca5fabc4-b33c-4fd7-9776-a45672c60509",
              "name": "Success",
              "originalRequest": {
                "url": {
                  "path": [
                    "open",
                    ":filename"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "newLeaf",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<path>",
                      "key": "filename",
                      "description": "(Required) Path to the file to return (relative to your vault root).\n"
                    },
                    {
                      "description": "Binding host",
                      "type": "any",
                      "value": "{{host}}",
                      "key": "host"
                    },
                    {
                      "description": "HTTPS port",
                      "type": "any",
                      "value": "{{port}}",
                      "key": "port"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
